@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Net.Http.Json
@namespace PolyglotLive
@inject HttpClient Http
@inject IJSRuntime Js

<header><a class="brand" href="./">cm<span> / </span>contribution-maxxing</a><a href="https://github.com/rawmware/contribution-maxxing">Source on GitHub ↗</a></header>
<main>
    <section class="hero">
        <p class="eyebrow">THE POLYGLOT LAB / 001</p>
        <h1>Different languages.<br /><span>Same playground.</span></h1>
        <p class="intro">Rust. C. C#. Real compiled code, running right here.<br />Explore the rest of the collection without leaving this page.</p>
        <div class="chips"><span>RUST / WASM</span><span>C / WASM</span><span>C# / .NET WASM</span></div>
    </section>
    @if (catalog is null)
    {
        <p role="status">@loadStatus</p>
    }
    else
    {
        <section class="workspace" aria-label="Language playground">
            <aside>
                <p class="eyebrow">01 / CHOOSE A LANGUAGE</p>
                <label for="search">Explore @catalog.Languages.Count languages</label>
                <input id="search" type="search" placeholder="Search languages…" @bind="query" @bind:event="oninput" />
                <nav class="language-list" aria-label="Programming languages">
                    @foreach (var language in FilteredLanguages)
                    {
                        <button class="language @(selected == language ? "selected" : "")" aria-pressed="@(selected == language)" disabled="@busy" @onclick="() => Select(language)">
                            <span>@language.DisplayName</span><small>@(language.IsLive ? "LIVE ↗" : "SOURCE")</small>
                        </button>
                    }
                </nav>
                @if (!FilteredLanguages.Any()) { <p>No languages match “@query”.</p> }
            </aside>
            <div class="workbench">
                @if (selected is not null)
                {
                    <div class="bench-heading"><div><p class="eyebrow">02 / EXPERIMENT</p><h2>@selected.DisplayName<span> workspace</span></h2></div><span class="badge">@(selected.IsLive ? "● BROWSER RUNTIME" : "SOURCE COLLECTION")</span></div>
                    @if (selected.IsLive)
                    {
                        <p>@RuntimeDescription</p>
                        <div class="controls">
                            <label>Algorithm<select disabled="@busy" value="@task" @onchange="ChangeTask"><option value="gcd">Greatest common divisor</option><option value="factorial">Factorial</option><option value="prime">Prime check</option><option value="fibonacci">Fibonacci sequence</option></select></label>
                            <label>@(task == "gcd" ? "Input A" : "Input n")<input disabled="@busy" type="number" min="0" max="@Maximum" step="1" @bind="inputA" /></label>
                            @if (task == "gcd") { <label>Input B<input disabled="@busy" type="number" min="0" max="1000000" step="1" @bind="inputB" /></label> }
                        </div>
                        <p class="hint">Whole numbers 0–@Maximum.ToString("N0"). @(task == "prime" ? "1 means prime; 0 means not prime." : "")</p>
                        <div class="actions"><button disabled="@busy" @onclick="Run">@(busy ? "Running…" : $"Run {selected.DisplayName} →")</button><button class="secondary" disabled="@busy" @onclick="Compare">Compare all three</button><button class="secondary" disabled="@busy" @onclick="Verify">Run shared tests</button></div>
                        <div class="terminal"><div class="terminal-bar"><span>● ● ●</span><span>execution output</span></div><output aria-live="polite">@result</output></div>
                        @if (comparisons.Count > 0)
                        {
                            <table><caption>Same inputs, independent implementations</caption><thead><tr><th>Language</th><th>Result</th></tr></thead><tbody>@foreach (var row in comparisons) { <tr><td>@row.Key</td><td>@row.Value</td></tr> }</tbody></table>
                        }
                    }
                    else
                    {
                        <p>This language is represented by repository source and shared test vectors. Its compiler is not loaded in the browser. Use Rust, C, or C# for live execution.</p>
                    }
                    <div class="source-heading"><p class="eyebrow">03 / READ THE IMPLEMENTATION</p><span>@selected.Examples.Count files</span></div>
                    @foreach (var source in selected.Examples)
                    {
                        <details @key="source.Source"><summary>@source.Task <span>@source.Source</span></summary><pre><code>@source.Code</code></pre><a href="@SourceUrl(source.Source)">Open source on GitHub ↗</a>
                            @if (catalog.Vectors.TryGetValue(source.Task, out var vectors))
                            {
                                <p>@vectors.Description</p><p class="hint">@vectors.Cases.Length shared test cases. Expected values are fixtures, not live output.</p>
                            }
                        </details>
                    }
                }
            </div>
        </section>
        <section class="about"><div><p class="eyebrow">BUILT FROM SOURCE</p><h2>A repository you can explore.</h2></div><p>The interface itself runs in C#. Rust and C compile to WebAssembly. HTML only starts the application; language examples remain inspectable source files in the repository.</p></section>
        <footer><span>@catalog.Languages.Count languages · @catalog.Languages.Sum(l => l.Examples.Count) source files</span><span>Build @(catalog.Revision?[..Math.Min(8, catalog.Revision.Length)] ?? "local") · @catalog.BuiltAt</span></footer>
    }
</main>

